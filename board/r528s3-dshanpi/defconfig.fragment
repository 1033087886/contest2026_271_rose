# Xiao V application fragment for the official R528S3 DShanPi nsh config.
CONFIG_EXAMPLES_XIAOV=y
CONFIG_EXAMPLES_XIAOV_AUDIO_ALSA=y
# CONFIG_EXAMPLES_XIAOV_AUDIO_MEDIA_FRAMEWORK is not set
CONFIG_EXAMPLES_XIAOV_CAPTURE_HANGOVER_MS=2000
CONFIG_EXAMPLES_XIAOV_CONNECT_TIMEOUT_MS=10000
CONFIG_EXAMPLES_XIAOV_HEARTBEAT_MS=30000
CONFIG_EXAMPLES_XIAOV_KWS=y
CONFIG_EXAMPLES_XIAOV_KWS_CAPTURE_MAX_GAIN_Q8=768
CONFIG_EXAMPLES_XIAOV_KWS_CAPTURE_TARGET_PEAK=20000
CONFIG_EXAMPLES_XIAOV_KWS_CONSECUTIVE_HITS=1
CONFIG_EXAMPLES_XIAOV_KWS_SCORE_THRESHOLD_Q15=28672
CONFIG_EXAMPLES_XIAOV_KWS_TENSOR_ARENA_BYTES=131072
CONFIG_EXAMPLES_XIAOV_KWS_VAD_HOLD_MS=2500
CONFIG_EXAMPLES_XIAOV_LVGL=y
CONFIG_EXAMPLES_XIAOV_MAX_CAPTURE_MS=30000
CONFIG_EXAMPLES_XIAOV_OFFLINE_COMMANDS=y
CONFIG_EXAMPLES_XIAOV_TOKEN_PATH="/data/xiaov.token"
CONFIG_EXAMPLES_XIAOV_CA_BUNDLE_PATH="/resource/etc/ssl/curl/ca-certificates.crt"
CONFIG_EXAMPLES_XIAOV_UI_WORKER_STACKSIZE=36864
CONFIG_TFLITEMICRO=y
CONFIG_MATH_GEMMLOWP=y
CONFIG_MATH_KISSFFT=y
CONFIG_MATH_RUY=y
CONFIG_SYSTEM_FLATBUFFERS=y
